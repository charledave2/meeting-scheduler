<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="false" android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@drawable/ic_meeting_scheduler" android:roundIcon="@drawable/ic_meeting_scheduler" android:usesCleartextTraffic="false">
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="meeting_assignments" />
        <service android:name=".MeetingSchedulerMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <receiver android:name=".ShareTargetChosenReceiver" android:exported="false" />
        <activity android:name=".MainActivity" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity-alias android:name=".LauncherTonalSpot" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_tonal_spot" android:enabled="false" android:exported="true" android:theme="@style/AppThemeTonalSpot">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNeutral" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_neutral" android:enabled="false" android:exported="true" android:theme="@style/AppThemeNeutral">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherVibrant" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_vibrant" android:enabled="false" android:exported="true" android:theme="@style/AppThemeVibrant">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherExpressive" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_expressive" android:enabled="false" android:exported="true" android:theme="@style/AppThemeExpressive">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherTonalSpotDark" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_tonal_spot" android:enabled="true" android:exported="true" android:theme="@style/AppThemeTonalSpotDark">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherNeutralDark" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_neutral" android:enabled="false" android:exported="true" android:theme="@style/AppThemeNeutralDark">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherVibrantDark" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_vibrant" android:enabled="false" android:exported="true" android:theme="@style/AppThemeVibrantDark">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherExpressiveDark" android:targetActivity=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher_expressive" android:enabled="false" android:exported="true" android:theme="@style/AppThemeExpressiveDark">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
    </application>
</manifest>


