    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppThemeTonalSpot" parent="AppTheme" />
    <style name="AppThemeNeutral" parent="AppTheme" />
    <style name="AppThemeVibrant" parent="AppTheme" />
    <style name="AppThemeExpressive" parent="AppTheme" />
</resources>

