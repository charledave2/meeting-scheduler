<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F2</item>
        <item name="android:navigationBarColor">#F7F8F2</item>
        <item name="android:colorAccent">#176B50</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AppThemeTonalSpot" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_tonal_spot_light</item>
        <item name="android:statusBarColor">@color/splash_tonal_spot_light</item>
        <item name="android:navigationBarColor">@color/splash_tonal_spot_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeNeutral" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_neutral_light</item>
        <item name="android:statusBarColor">@color/splash_neutral_light</item>
        <item name="android:navigationBarColor">@color/splash_neutral_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeVibrant" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_vibrant_light</item>
        <item name="android:statusBarColor">@color/splash_vibrant_light</item>
        <item name="android:navigationBarColor">@color/splash_vibrant_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeExpressive" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_expressive_light</item>
        <item name="android:statusBarColor">@color/splash_expressive_light</item>
        <item name="android:navigationBarColor">@color/splash_expressive_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeTonalSpotDark" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_tonal_spot_dark</item>
        <item name="android:statusBarColor">@color/splash_tonal_spot_dark</item>
        <item name="android:navigationBarColor">@color/splash_tonal_spot_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppThemeNeutralDark" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_neutral_dark</item>
        <item name="android:statusBarColor">@color/splash_neutral_dark</item>
        <item name="android:navigationBarColor">@color/splash_neutral_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppThemeVibrantDark" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_vibrant_dark</item>
        <item name="android:statusBarColor">@color/splash_vibrant_dark</item>
        <item name="android:navigationBarColor">@color/splash_vibrant_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppThemeExpressiveDark" parent="AppTheme">
        <item name="android:windowBackground">@color/splash_expressive_dark</item>
        <item name="android:statusBarColor">@color/splash_expressive_dark</item>
        <item name="android:navigationBarColor">@color/splash_expressive_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
